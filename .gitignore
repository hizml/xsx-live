# 数据目录：凭据、运行状态和自动生成的播放页，只存在于部署机器上，绝不提交
xsx-files/

# Credentials and private authentication
auth/session.json
auth/*.json
!auth/session.json.example

# Runtime state, cache and logs
state/*
!state/.gitignore
*.log
*.tar.gz

# Environment files
.env
.env.local

# Rust build artifacts
receiver/target/
**/*.rs.bk
Cargo.lock.orig

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
