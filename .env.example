# ==========================================
# XSX-Live Environment Configuration
# ==========================================

# Your Xbox Series X / S local network IP address. The receiver exchanges
# audio and video with this address only; when set it must be correct.
# Since 1.1.0 (experimental) it can be left unset: the receiver then takes the
# console address and port from the session configuration
XBOX_IP=192.168.1.180

# Service Bind IP on the host machine (0.0.0.0 for all interfaces)
BIND_IP=0.0.0.0

# Dashboard listening address (IP:PORT). 0.0.0.0 listens on every interface;
# the page can only be opened by IP, not by hostname. Uncommon ports are used
# to avoid clashes with other services
DASHBOARD_BIND=0.0.0.0:31099

# Base HTTP URL for streaming playback accessed by clients/browsers.
# The default works since 1.0.1: the dashboard generates player and stream
# addresses from the IP you open it with. Only change the port here if the
# media HTTP port is not 8888
# Example: http://<YOUR_HOST_IP>:31888
MEDIA_HTTP_BASE=http://127.0.0.1:31888

# SRS RTMP ingestion destination
OUTPUT_RTMP=rtmp://127.0.0.1:31935/live/xsx

# Receiver image. By default the image is built locally and named
# xsx-live/receiver:latest, which is also the name used by the image archive
# from GitHub Actions. To use the image published on GitHub instead, set this to
# ghcr.io/hizml/xsx-live-receiver:<version> and run: docker compose pull
# XSX_IMAGE=xsx-live/receiver:latest

# Timezone for log timestamps
TZ=Asia/Shanghai

# Nudge the left stick when the console warns about idleness (1) or not (0)
IDLE_KEEPALIVE=1

# Optional: your own Microsoft app registration for the dashboard login
# XBOX_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional HTTPS redirect URI registered in that app; leave unset to paste the
# redirected URL back into the dashboard
# AUTH_REDIRECT_URI=https://example.com/xsx/auth/callback
# Optional: console server ID, when the account owns several consoles
# XBOX_SERVER_ID=
